# =============================================================================
# File: Containerfile.samba-build
# Description: UBI 9 build environment for the samba-ad-dc RPM.
#
# Credentials: see Containerfile.samba-test. Use a registered RHEL host or
#   podman build --secret id=rhsm,src=<file with RH_USER=... RH_PASS=...>
# CodeReady Builder (for *-devel headers) must be enabled on the host or by
# the registration below. NEVER use --build-arg for passwords.
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi:latest

RUN --mount=type=secret,id=rhsm,required=false \
    if [ -s /run/secrets/rhsm ]; then \
        . /run/secrets/rhsm && \
        subscription-manager register --username="${RH_USER}" --password="${RH_PASS}" && \
        subscription-manager repos \
            --enable=rhel-9-for-x86_64-appstream-rpms \
            --enable=rhel-9-for-x86_64-baseos-rpms \
            --enable=codeready-builder-for-rhel-9-x86_64-rpms ; \
    fi && \
    dnf install -y \
        gcc make autoconf automake python3-devel python3-markdown python3-dns python3-cryptography \
        flex bison perl-Parse-Yapp perl-FindBin perl-File-Compare perl-File-Copy perl-devel \
        krb5-devel krb5-server \
        libacl-devel libattr-devel \
        openldap-devel pam-devel \
        gnutls-devel gpgme-devel lmdb-devel \
        libtirpc-devel jansson-devel popt-devel \
        libarchive-devel libicu-devel dbus-devel \
        libxml2-devel libxslt-devel bind-devel \
        docbook-style-xsl docbook-dtds \
        systemd-rpm-macros python3-rpm-macros \
        rpm-build rsync git && \
    if subscription-manager status >/dev/null 2>&1; then \
        subscription-manager unregister ; \
    fi && \
    dnf clean all

WORKDIR /build
